set shell := ["bash", "-euo", "pipefail", "-c"]

# Three-environment desired-vs-actual access gate. Reads public recipient metadata only.
access-audit:
    ores-sops-access-audit check --require-stage --require-stage-exclusive --require-ciphertext

# Stronger policy requiring a true production-only identity too.
access-audit-strict:
    ores-sops-access-audit check --require-stage --require-stage-exclusive --require-prod-exclusive --require-ciphertext

# Explicit bootstrap mode for a policy created before ciphertext exists.
access-policy-only:
    ores-sops-access-audit check --require-stage --require-stage-exclusive --policy-only

# Explicitly display desired public recipients. No private identity or secret value is read.
public-recipients:
    ores-sops-access-audit show

# Synchronize only the selected ciphertext with its exact recipient rule.
rekey environment:
    case "{{environment}}" in dev|stage|prod) ;; *) echo "expected dev, stage, or prod" >&2; exit 2 ;; esac
    ores-sops sync-keys "{{environment}}"
    ores-sops-access-audit check --require-stage --require-stage-exclusive --require-ciphertext

# Use after recipient removal when a fresh per-file data key is required.
rotate-data-key environment:
    case "{{environment}}" in dev|stage|prod) ;; *) echo "expected dev, stage, or prod" >&2; exit 2 ;; esac
    sops --rotate --in-place --input-type dotenv --output-type dotenv "env/enc/{{environment}}.env.enc"
    ores-sops-access-audit check --require-stage --require-stage-exclusive --require-ciphertext

verify:
    ores-sops verify
    ores-sops-access-audit check --require-stage --require-stage-exclusive --require-ciphertext
