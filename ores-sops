#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" >/dev/null 2>&1 && pwd -P)"
CORE="${SCRIPT_DIR}/scripts/ores-sops-core"
CONFIG="${SCRIPT_DIR}/.cli-flags.toml"
TELEMETRY="${SCRIPT_DIR}/scripts/ores-sops-telemetry"

emit_diag() {
  if [[ -x "${TELEMETRY}" ]]; then
    "${TELEMETRY}" "$@" || true
  fi
}

fail() {
  local event="$1"
  local message="$2"
  local key="${3:-}"
  local command="${4:-unknown}"
  emit_diag "${event}" "${command}" "" "${key}" "2"
  printf 'ores-sops: %s\n' "${message}" >&2
  exit 2
}

run_exec() {
  local name="${1:-}" delimiter="${2:-}" root policy src os_name
  local arg total_bytes=0 line key value seen_keys decrypt_pid decrypt_status parse_error=0
  shift 2 || true

  case "$name" in
    dev|stage|prod) ;;
    *) fail invalid_environment "environment must be dev, stage, or prod" "ORES_SOPS_ENVIRONMENT" "exec" ;;
  esac
  [[ "$delimiter" == "--" && "$#" -gt 0 ]] || \
    fail argv_admission_rejected "exec requires a bare -- followed by a command" "" "exec"

  os_name="$(uname -s 2>/dev/null || true)"
  case "$os_name" in
    MINGW*|MSYS*|CYGWIN*|Windows_NT)
      fail unsupported_platform "exec currently requires a POSIX execution boundary" "" "exec"
      ;;
  esac

  command -v sops >/dev/null 2>&1 || \
    fail dependency_missing "required dependency sops is not available" "sops" "exec"
  command -v git >/dev/null 2>&1 || \
    fail dependency_missing "required dependency git is not available" "git" "exec"

  root="$(git rev-parse --show-toplevel 2>/dev/null)" || \
    fail repository_missing "not inside a git repository" "" "exec"
  policy="$root/.sops.yaml"
  src="$root/env/enc/$name.env.enc"

  [[ ! -L "$root/env" && ! -L "$root/env/enc" ]] || \
    fail unsafe_path "managed env/enc path must not be a symlink" "" "exec"
  [[ -d "$root/env/enc" ]] || \
    fail ciphertext_missing "managed env/enc directory is missing" "" "exec"
  [[ -f "$policy" && ! -L "$policy" ]] || \
    fail policy_invalid "managed .sops.yaml must be a regular non-symlink file" "" "exec"
  [[ -f "$src" && ! -L "$src" ]] || \
    fail ciphertext_missing "selected encrypted environment is missing or unsafe" "" "exec"

  if ! grep -Fq "path_regex: ^env/enc/$name\\.env\\.enc$" "$policy"; then
    fail policy_invalid "selected environment has no exact SOPS creation rule" "" "exec"
  fi

  if (( $# > 128 )); then
    fail argv_admission_rejected "exec downstream argv exceeds the supported argument count" "" "exec"
  fi
  [[ -n "${1:-}" ]] || \
    fail argv_admission_rejected "exec command must not be empty" "" "exec"

  for arg in "$@"; do
    if (( ${#arg} > 4096 )) || [[ "$arg" =~ [[:cntrl:]] ]]; then
      fail argv_admission_rejected "exec downstream argv contains an unsupported token" "" "exec"
    fi
    total_bytes=$((total_bytes + ${#arg} + 1))
    (( total_bytes <= 32768 )) || \
      fail argv_admission_rejected "exec downstream argv exceeds the supported size" "" "exec"
  done

  # Keep decrypted bytes off disk and out of argv. SOPS writes canonical dotenv
  # to an anonymous pipe; this process parses only KEY=value records, restores
  # the dotenv store's escaped newlines, and exports each value without eval or
  # source. The child receives the original argv array directly, so attacker-
  # controlled command arguments are never reparsed as shell syntax.
  seen_keys=$'\n'
  exec 9< <(
    cd "$root" &&
      sops decrypt --input-type dotenv --output-type dotenv "$src" 2>/dev/null
  )
  decrypt_pid=$!

  while IFS= read -r line <&9 || [[ -n "$line" ]]; do
    case "$line" in
      ""|\#*) continue ;;
    esac
    case "$line" in
      [A-Za-z_][A-Za-z0-9_]*=*) ;;
      *) parse_error=1; continue ;;
    esac

    key="${line%%=*}"
    case "$seen_keys" in
      *$'\n'"$key"$'\n'*) parse_error=1; continue ;;
    esac
    seen_keys+="$key"$'\n'

    value="${line#*=}"
    value="${value//\\n/$'\n'}"
    printf -v "$key" '%s' "$value"
    export "$key"
  done
  exec 9<&-

  set +e
  wait "$decrypt_pid"
  decrypt_status=$?
  set -e

  (( decrypt_status == 0 )) || \
    fail decrypt_failed "could not decrypt selected environment" "" "exec"
  (( parse_error == 0 )) || \
    fail dotenv_invalid "decrypted environment is not canonical dotenv" "" "exec"

  "$@"
}

[[ -x "${CORE}" ]] || fail core_missing "internal core executable is missing"
[[ -f "${CONFIG}" ]] || fail config_missing ".cli-flags.toml is missing"

command_name="${1:-help}"
case "${command_name}" in
  init|use|exec|refresh|encrypt|edit|sync-keys|diff|status|lock|verify|precommit|ensure-dec|install-hooks|help|version) ;;
  -h|--help) command_name="help" ;;
  -V|--version) command_name="version" ;;
  *) command_name="unknown" ;;
esac

if ! command -v flags2env >/dev/null 2>&1; then
  fail dependency_missing "required dependency flags2env is not available" "flags2env" "${command_name}"
fi
if ! command -v node >/dev/null 2>&1; then
  fail dependency_missing "required dependency node is not available" "node" "${command_name}"
fi

# The repository-root contract must itself be admissible before parsing argv.
# Suppress audit output: diagnostics report only the fixed failure class.
if ! (cd "${SCRIPT_DIR}" && flags2env audit "${CONFIG}" >/dev/null 2>&1); then
  fail config_invalid ".cli-flags.toml admission audit failed" "" "${command_name}"
fi

# Normalize help/version aliases only for admission so flags2env emits its JSON
# channels rather than a help table. The legacy core still receives public argv.
admission_args=("$0" "$@")
case "${1:-}" in
  ""|-h|--help) admission_args=("$0" help) ;;
  -V|--version) admission_args=("$0" version) ;;
esac

# Keep the checker source literal. The quoted heredoc prevents shell expansion
# of JavaScript `$` syntax and keeps attacker-controlled argv out of executable
# shell source without suppressing ShellCheck diagnostics.
NODE_ADMISSION_SCRIPT="$(cat <<'EOF_NODE'
let text = "";
process.stdin.setEncoding("utf8");
process.stdin.on("data", (chunk) => {
  text += chunk;
  if (text.length > 262144) process.exit(2);
});
process.stdin.on("end", () => {
  try {
    const parsed = JSON.parse(text);
    const decodeList = (key) => {
      if (parsed[key] === undefined) return [];
      const raw = parsed[key];
      if (typeof raw !== "string") return null;
      const value = JSON.parse(raw);
      return Array.isArray(value) && value.every((item) => typeof item === "string")
        ? value
        : null;
    };
    const unknown = decodeList("ORES_SOPS_UNKNOWN_OPTIONS");
    const errors = decodeList("ORES_SOPS_PARSE_ERRORS");
    const positionals = decodeList("ORES_SOPS_POSITIONALS");
    const command = parsed.ORES_SOPS_COMMAND;
    const expected = process.env.ORES_SOPS_EXPECTED_COMMAND;
    if (
      !unknown || !errors || !positionals ||
      unknown.length !== 0 || errors.length !== 0 ||
      typeof command !== "string" || command !== expected
    ) {
      process.exit(2);
      return;
    }

    if (positionals.length < 2) {
      process.exit(2);
      return;
    }
    const operands = positionals.slice(2);
    const profileCommands = new Set(["use", "encrypt", "edit", "sync-keys", "diff"]);
    if (profileCommands.has(command)) {
      if (operands.length > 1) process.exit(2);
      if (
        operands.length === 1 &&
        !["dev", "stage", "prod"].includes(operands[0])
      ) process.exit(2);
    } else if (command === "exec") {
      // The wrapper owns semantic checks for a missing `--` or child command
      // so diagnostics stay fixed and redacted. This layer only bounds any
      // downstream argv that flags2env did observe.
      if (operands.length > 128) process.exit(2);
      let bytes = 0;
      for (const operand of operands) {
        if (operand.length > 4096 || /[\u0000-\u001f\u007f]/u.test(operand)) process.exit(2);
        bytes += Buffer.byteLength(operand, "utf8") + 1;
        if (bytes > 32768) process.exit(2);
      }
      if (operands.length > 0 && operands[0].length === 0) process.exit(2);
    } else if (operands.length !== 0) {
      process.exit(2);
    }
  } catch {
    process.exit(2);
  }
});
EOF_NODE
)"

# Parse the real argv through flags2env and consume only its closed command,
# unknown-option, parse-error, and positional channels. Parser stdout is piped
# directly into a bounded JSON checker; it is never eval'd, exported, logged,
# written to disk, or placed on another process' argv. Parser stderr is
# suppressed because it may reflect attacker-controlled command-line input.
if ! (
  cd "${SCRIPT_DIR}"
  flags2env "${admission_args[@]}" 2>/dev/null |
    ORES_SOPS_EXPECTED_COMMAND="${command_name}" node -e "${NODE_ADMISSION_SCRIPT}" 2>/dev/null
); then
  fail argv_admission_rejected "command-line admission failed" "" "${command_name}"
fi

[[ "${command_name}" != "unknown" ]] || \
  fail argv_admission_rejected "unknown command" "" "unknown"

args=("$@")
safe_profile=""
normalized=()

if [[ "${command_name}" =~ ^(use|encrypt|edit|sync-keys|diff)$ ]]; then
  normalized+=("${args[0]}")
  i=1
  while (( i < ${#args[@]} )); do
    arg="${args[$i]}"
    case "${arg}" in
      --environment=*)
        candidate="${arg#--environment=}"
        [[ -z "${safe_profile}" || "${safe_profile}" == "${candidate}" ]] || \
          fail environment_conflict "environment was supplied more than once with conflicting values" "ORES_SOPS_ENVIRONMENT" "${command_name}"
        safe_profile="${candidate}"
        ;;
      --environment)
        (( i + 1 < ${#args[@]} )) || fail required_env_missing "required environment is missing" "ORES_SOPS_ENVIRONMENT" "${command_name}"
        i=$((i + 1))
        candidate="${args[$i]}"
        [[ -z "${safe_profile}" || "${safe_profile}" == "${candidate}" ]] || \
          fail environment_conflict "environment was supplied more than once with conflicting values" "ORES_SOPS_ENVIRONMENT" "${command_name}"
        safe_profile="${candidate}"
        ;;
      dev|stage|prod)
        [[ -z "${safe_profile}" || "${safe_profile}" == "${arg}" ]] || \
          fail environment_conflict "environment was supplied more than once with conflicting values" "ORES_SOPS_ENVIRONMENT" "${command_name}"
        safe_profile="${arg}"
        ;;
      -*)
        normalized+=("${arg}")
        ;;
      *)
        fail argv_admission_rejected "command-line admission failed" "" "${command_name}"
        ;;
    esac
    i=$((i + 1))
  done

  if [[ -z "${safe_profile}" ]]; then
    if [[ -z "${ORES_SOPS_ENVIRONMENT:-}" ]]; then
      fail required_env_missing "required environment is missing" "ORES_SOPS_ENVIRONMENT" "${command_name}"
    fi
    safe_profile="${ORES_SOPS_ENVIRONMENT}"
  fi

  case "${safe_profile}" in
    dev|stage|prod) ;;
    *) fail invalid_environment "environment must be dev, stage, or prod" "ORES_SOPS_ENVIRONMENT" "${command_name}" ;;
  esac

  normalized+=("${safe_profile}")
  args=("${normalized[@]}")
elif [[ "${command_name}" == "exec" ]]; then
  normalized+=("exec")
  exec_argv=()
  saw_delimiter=0
  i=1
  while (( i < ${#args[@]} )); do
    arg="${args[$i]}"
    if (( saw_delimiter == 1 )); then
      exec_argv+=("${arg}")
      i=$((i + 1))
      continue
    fi
    case "${arg}" in
      --environment=*|--env=*)
        candidate="${arg#*=}"
        [[ -z "${safe_profile}" || "${safe_profile}" == "${candidate}" ]] || \
          fail environment_conflict "environment was supplied more than once with conflicting values" "ORES_SOPS_ENVIRONMENT" "${command_name}"
        safe_profile="${candidate}"
        ;;
      --environment|--env)
        (( i + 1 < ${#args[@]} )) || fail required_env_missing "required environment is missing" "ORES_SOPS_ENVIRONMENT" "${command_name}"
        i=$((i + 1))
        candidate="${args[$i]}"
        [[ -z "${safe_profile}" || "${safe_profile}" == "${candidate}" ]] || \
          fail environment_conflict "environment was supplied more than once with conflicting values" "ORES_SOPS_ENVIRONMENT" "${command_name}"
        safe_profile="${candidate}"
        ;;
      --)
        saw_delimiter=1
        ;;
      *)
        fail argv_admission_rejected "command-line admission failed" "" "${command_name}"
        ;;
    esac
    i=$((i + 1))
  done

  [[ -n "${safe_profile}" ]] || \
    fail required_env_missing "required environment is missing" "ORES_SOPS_ENVIRONMENT" "${command_name}"
  case "${safe_profile}" in
    dev|stage|prod) ;;
    *) fail invalid_environment "environment must be dev, stage, or prod" "ORES_SOPS_ENVIRONMENT" "${command_name}" ;;
  esac
  (( saw_delimiter == 1 && ${#exec_argv[@]} > 0 )) || \
    fail argv_admission_rejected "exec requires a bare -- followed by a command" "" "${command_name}"

  normalized+=("${safe_profile}" "--" "${exec_argv[@]}")
  args=("${normalized[@]}")
fi

emit_diag command_started "${command_name}" "${safe_profile}" "" "0"

set +e
if [[ "${command_name}" == "exec" ]]; then
  run_exec "${args[@]:1}"
  status=$?
else
  "${CORE}" "${args[@]}"
  status=$?
fi
set -e

if (( status == 0 )); then
  emit_diag command_completed "${command_name}" "${safe_profile}" "" "0"
else
  emit_diag command_failed "${command_name}" "${safe_profile}" "" "${status}"
fi
exit "${status}"