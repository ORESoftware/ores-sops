#!/usr/bin/env bash
set -euo pipefail

[[ "${ORES_SOPS_TELEMETRY:-1}" == "0" ]] && exit 0

event="${1:-}"
command_name="${2:-unknown}"
profile="${3:-}"
key_name="${4:-}"
exit_code="${5:-0}"

# Closed event mapping: callers cannot supply arbitrary log messages or levels.
# This keeps the Bash boundary payload-free apart from allow-listed metadata and
# makes the stderr record safe for the ores-otel/platform logging pipeline.
case "${event}" in
  core_missing)
    level="error"
    message="internal core executable is missing"
    ;;
  config_missing)
    level="error"
    message=".cli-flags.toml is missing"
    ;;
  dependency_missing)
    level="error"
    message="required dependency is not available"
    ;;
  argv_admission_rejected)
    level="error"
    message="command-line admission failed"
    ;;
  environment_conflict)
    level="error"
    message="environment was supplied more than once with conflicting values"
    ;;
  required_env_missing)
    level="error"
    message="required environment is missing"
    ;;
  invalid_environment)
    level="error"
    message="environment must be dev, stage, or prod"
    ;;
  command_started)
    level="info"
    message="ores-sops command admitted"
    ;;
  command_completed)
    level="info"
    message="ores-sops command completed"
    ;;
  command_failed)
    level="error"
    message="ores-sops command failed"
    ;;
  *)
    # Unknown telemetry events are rejected without echoing attacker-controlled
    # input. The wrapper treats diagnostics as best-effort and continues.
    exit 2
    ;;
esac

case "${command_name}" in
  init|use|refresh|encrypt|edit|sync-keys|diff|status|lock|verify|precommit|install-hooks|help|version|unknown) ;;
  *) command_name="unknown" ;;
esac
case "${profile}" in ""|dev|stage|prod) ;; *) profile="" ;; esac
case "${key_name}" in
  ""|ORES_SOPS_ENVIRONMENT|flags2env) ;;
  *) key_name="redacted-key-name" ;;
esac
if [[ ! "${exit_code}" =~ ^[0-9]{1,3}$ ]] || (( 10#${exit_code} > 255 )); then
  exit_code="1"
fi

json_escape() {
  local s="$1"
  s=${s//\\/\\\\}
  s=${s//\"/\\\"}
  s=${s//$'\n'/\\n}
  s=${s//$'\r'/\\r}
  s=${s//$'\t'/\\t}
  printf '%s' "${s}"
}

printf '{"schema":"ores.sops/diagnostic/v1","level":"%s","component":"ores-sops","event":"%s","message":"%s","details":{"command":"%s","profile":"%s","key":"%s","exitCode":%s}}\n' \
  "$(json_escape "${level}")" \
  "$(json_escape "${event}")" \
  "$(json_escape "${message}")" \
  "$(json_escape "${command_name}")" \
  "$(json_escape "${profile}")" \
  "$(json_escape "${key_name}")" \
  "${exit_code}" >&2
