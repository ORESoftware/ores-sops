{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ores.sops.runtime-config.schema.json",
  "$defs": {
    "OresSopsDiagnosticsMode": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "$id": "OresSopsDiagnosticsMode",
      "type": "string",
      "enum": ["key-name-only"]
    },
    "OresSopsExecutionConfig": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "$id": "OresSopsExecutionConfig",
      "type": "object",
      "properties": {
        "fail_closed": { "const": true },
        "persist_plaintext": { "const": false },
        "diagnostics": { "$ref": "OresSopsDiagnosticsMode" }
      },
      "required": ["fail_closed", "persist_plaintext", "diagnostics"],
      "unevaluatedProperties": false
    },
    "OresSopsRuntimeConfig": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "$id": "OresSopsRuntimeConfig",
      "type": "object",
      "properties": {
        "schema_version": { "type": "integer", "const": 1 },
        "protocol": { "type": "string", "const": "ores.sops.consumer-config/v1" },
        "environment": { "type": "string", "pattern": "^[a-z][a-z0-9_-]*$" },
        "profile": { "type": "string", "pattern": "^[a-z][a-z0-9_-]*$" },
        "portable_config_path": { "type": "string", "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$" },
        "ciphertext_path": { "type": "string", "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$" },
        "execution": { "$ref": "OresSopsExecutionConfig" }
      },
      "required": ["schema_version", "protocol", "environment", "profile", "portable_config_path", "ciphertext_path", "execution"],
      "unevaluatedProperties": false
    }
  }
}
